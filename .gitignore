# Node and package-manager caches (commit lockfiles)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.pnp.*

# Builds, caches, coverage, and test output
dist/
build/
.cache/
.vite/
.generated/
coverage/
reports/
playwright-report/
test-results/
*.tsbuildinfo

# Logs and temporary files
logs/
*.log
*.tmp
tmp/

# Local environment configuration; tracked examples contain placeholders only
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
!.dev.vars.*.example

# Cloudflare state, local databases, credentials, and private data
.wrangler/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.pem
*.key
*.pfx
/private-data/
/data/private/
/mailbox-exports/
/backups/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
